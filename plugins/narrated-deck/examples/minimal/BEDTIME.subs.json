{
  "prefix": "BEDTIME",
  "title": "小狐狸找月亮 ‧ 一個睡前故事",
  "subs": [
    { "id": "001", "scene": "s01", "text": "", "dur": 3 },
    { "id": "002", "scene": "s02", "text": "從前從前，森林裡住著一隻小狐狸。" },
    { "id": "003", "scene": "s02", "text": "牠的名字叫做小米。" },
    { "id": "004", "scene": "s03", "text": "有一天晚上，小米抬頭看見天上有一個圓圓的、亮亮的東西。" },
    { "id": "005", "scene": "s03", "text": "「那是什麼呀？」小米好奇地問。" },
    { "id": "006", "scene": "s04", "text": "媽媽輕輕地說：「那是月亮。」" },
    { "id": "007", "scene": "s04", "text": "「月亮每天晚上都會出來，陪著大家睡覺。」" },
    { "id": "008", "scene": "s05", "text": "小米開心地笑了。" },
    { "id": "009", "scene": "s05", "text": "原來，月亮一直都在天上看著我們。" },
    { "id": "010", "scene": "s06", "text": "晚安，小米。晚安，月亮。" },
    { "id": "011", "scene": "s06", "text": "" , "dur": 5 }
  ]
}
